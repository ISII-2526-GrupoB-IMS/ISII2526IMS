@page "/Compras/DetalleCompra/{IdCompra:int}"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web
@inject ComprasStateContainer CompraState
@inject NavigationManager Navigation
@rendermode InteractiveServer

<table class="table table-borderless table-sm">
    <tr>
        <th>Name and Surname</th>
        <td id="NameSurname">@CompraState.Compra.NombreUsuario @CompraState.Compra.ApellidosUsuario</td>
    </tr>
    <tr>
        <th>Delivery Address</th>
        <td id="DeliveryAddress">@CompraState.Compra.DireccionDeEnvio</td>
    </tr>
    
    <tr>
        <th>Fecha compra</th>
        <td id="FechaCompra">
            @(CompraState.Compra.FechaCompra == default
                        ? DateTime.Now.ToShortDateString()
                        : CompraState.Compra.FechaCompra.DateTime.ToShortDateString())
        </td>
    </tr>
    
</table>

<h4>Dispositivos Comprados</h4>

<table class="table" id="RentedMovies">
    <thead>
        <tr>
            <th scope="col">Nombre</th>
            <th scope="col">Modelo</th>
            <th scope="col">Color</th>
            <th scope="col">Precio</th>
            <th scope="col">Cantidad</th>
            <th scope="col">Descripcion</th>
        </tr>
    </thead>
    <tbody>
        @foreach (CompraItemDTO item in CompraState.Compra.ItemsCompra)
        {
            <tr id="RentalItem_@item.Marca">
                <td>@item.Modelo</td>
                <td>@item.Marca</td>
                <td>@item.Color</td>
                <td>@item.Precio.ToString("C2")</td>
                <td>@item.Cantidad</td>
                <td>@item.Descripcion</td>
                
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <span class="h5">Cantidad total de Dispositivos</span>
            <td id="CantidadTotal" class="fw-bold">@CompraState.Compra.Cantidad</td>
            <span class="h5">Total (EUR)</span>
            <td id="TotalPrice" class="fw-bold">@CompraState.TotalPrice.ToString("C2")</td>
        </tr>
    </tfoot>

</table>


@code {
    [Parameter]
    public int IdCompra { get; set; }
    private CompraDetailDTO compra;

    protected override void OnInitialized()
    {
        if (CompraState.Compra.ItemsCompra.Count == 0)
        {
            Navigation.NavigateTo("/Compras/SelectDispositivosComprar");
        }
    }

   

    
}